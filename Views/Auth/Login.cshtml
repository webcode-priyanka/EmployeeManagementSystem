@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - Employee Management System</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
            min-height: 100vh;
        }

        /* ================= WRAPPER ================= */

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 20px;
        }

        /* ================= CARD ================= */

        .login-card {
            width: 100%;
            max-width: 1050px;
            min-height: 570px;
            background: #ffffff;
            border-radius: 22px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 20px 55px rgba(0, 0, 0, 0.10);
        }

        /* ================= LEFT PANEL ================= */

        .login-left {
            width: 45%;
            padding: 55px 48px;
            background: linear-gradient(135deg, #0d6efd, #084298);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .ems-logo {
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.20);
            border-radius: 16px;
            font-size: 30px;
            margin-bottom: 25px;
        }

        .login-left h1 {
            font-size: 34px;
            line-height: 1.25;
            font-weight: 700;
            margin-bottom: 16px;
        }

        .login-left p {
            color: rgba(255,255,255,0.85);
            font-size: 15px;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        /* ================= FEATURES ================= */

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
            font-size: 15px;
        }

            .feature i {
                font-size: 18px;
            }

        /* ================= RIGHT PANEL ================= */

        .login-right {
            width: 55%;
            padding: 55px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-right h2 {
                font-size: 30px;
                font-weight: 700;
                color: #172033;
                margin-bottom: 8px;
            }

        .login-subtitle {
            color: #7b8494;
            margin-bottom: 30px;
            font-size: 15px;
        }

        /* ================= FORM ================= */

        .form-label {
            font-weight: 600;
            color: #344054;
            margin-bottom: 8px;
        }

        .input-group {
            border-radius: 8px;
        }

        .input-group-text {
            background: #ffffff;
            border-right: 0;
            color: #667085;
            min-width: 48px;
            justify-content: center;
        }

        .form-control {
            height: 50px;
            border-left: 0;
            box-shadow: none !important;
            font-size: 14px;
        }

            .form-control::placeholder {
                color: #98a2b3;
            }

        .input-group:focus-within {
            box-shadow: 0 0 0 3px rgba(13,110,253,0.10);
            border-radius: 8px;
        }

            .input-group:focus-within .input-group-text,
            .input-group:focus-within .form-control {
                border-color: #86b7fe;
            }

        /* ================= BUTTON ================= */

        .login-btn {
            height: 52px;
            border-radius: 9px;
            font-size: 16px;
            font-weight: 600;
            margin-top: 8px;
            transition: 0.2s ease;
        }

            .login-btn:hover {
                transform: translateY(-1px);
            }

        /* ================= REGISTER ================= */

        .register-link {
            text-align: center;
            margin-top: 25px;
            color: #667085;
            font-size: 14px;
        }

            .register-link a {
                color: #0d6efd;
                text-decoration: none;
                font-weight: 600;
            }

                .register-link a:hover {
                    text-decoration: underline;
                }

        /* ================= VALIDATION ================= */

        .validation-summary {
            font-size: 14px;
            border-radius: 8px;
        }

        /* ================= RESPONSIVE ================= */

        @@media (max-width: 768px) {

            .login-wrapper {
                padding: 20px;
            }

            .login-card {
                flex-direction: column;
            }

            .login-left,
            .login-right {
                width: 100%;
            }

            .login-left {
                padding: 40px 30px;
            }

                .login-left h1 {
                    font-size: 28px;
                }

            .login-right {
                padding: 40px 30px;
            }
        }

        .forgot-password {
            text-align: right;
            margin-top: 8px;
        

            .forgot-password a {
                color: #2563eb;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
            }

                .forgot-password a:hover {
                    text-decoration: underline;
                }


    </style>
</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <!-- ================= LEFT PANEL ================= -->

            <div class="login-left">

                <div class="ems-logo">
                    <i class="bi bi-people-fill"></i>
                </div>

                <h1>
                    Employee Management System
                </h1>

                <p>
                    Manage employees, departments, attendance,
                    leaves and salaries through a simple and
                    professional management system.
                </p>

                <div class="feature">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Easy employee management</span>
                </div>

                <div class="feature">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Attendance & leave management</span>
                </div>

                <div class="feature">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Salary management</span>
                </div>

                <div class="feature">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Secure account authentication</span>
                </div>

            </div>


            <!-- ================= RIGHT PANEL ================= -->

            <div class="login-right">

                <h2>
                    Welcome Back
                </h2>

                <p class="login-subtitle">
                    Sign in to access your EMS dashboard.
                </p>


                <!-- LOGIN FORM -->

                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger validation-summary">
                    </div>


                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label class="form-label">
                            Email Address
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input name="email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="Enter your email address"
                                   required />

                        </div>

                    </div>


                    <!-- PASSWORD -->

                    <div class="mb-4">

                        <label class="form-label">
                            Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input name="password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Enter your password"
                                   required />

                        </div>

                        <div class="forgot-password">
                            <a asp-controller="Auth"
                               asp-action="ForgotPassword">
                                Forgot Password?
                            </a>
                        </div>

                    </div>


			


                    <!-- LOGIN BUTTON -->

                    <button type="submit"
                            class="btn btn-primary w-100 login-btn">

                        Sign In

                        <i class="bi bi-arrow-right ms-2"></i>

                    </button>


                    

                  
                </form>

            </div>

        </div>

    </div>

</body>
</html>