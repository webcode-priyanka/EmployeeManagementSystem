@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Password - Employee Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f5f7fb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .reset-wrapper {
            width: 100%;
            max-width: 430px;
            padding: 20px;
        }

        .reset-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 35px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .reset-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: #eef4ff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            font-size: 28px;
        }

        .reset-title {
            text-align: center;
            font-size: 25px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 8px;
        }

        .reset-description {
            text-align: center;
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
        }

        .form-control {
            padding: 11px 12px;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #86b7fe;
            }

        .btn-reset {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-weight: 600;
            font-size: 15px;
        }

            .btn-reset:hover {
                background: #1d4ed8;
                color: white;
            }

        .validation-message {
            color: #dc2626;
            font-size: 14px;
            margin-bottom: 15px;
        }

    </style>

</head>

<body>

    <div class="reset-wrapper">

        <div class="reset-card">

            <!-- Icon -->

            <div class="reset-icon">

                <i class="bi bi-shield-lock-fill"></i>

            </div>


            <!-- Heading -->

            <h2 class="reset-title">
                Reset Password
            </h2>

            <p class="reset-description">
                Enter your new password below.
            </p>


            <!-- Validation -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-message">

                    @Html.ValidationSummary(
                             true,
                             "",
                             new { @class = "text-danger" })

                </div>
            }


            <!-- Reset Password Form -->

            <form asp-controller="Auth"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="email"
                       value="@ViewBag.Email" />

                <input type="hidden"
                       name="token"
                       value="@ViewBag.Token" />


                <!-- New Password -->

                <div class="mb-3">

                    <label class="form-label">
                        New Password
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input type="password"
                               name="password"
                               class="form-control"
                               placeholder="Enter new password"
                               autocomplete="new-password"
                               required />

                    </div>

                </div>


                <!-- Confirm Password -->

                <div class="mb-4">

                    <label class="form-label">
                        Confirm New Password
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input type="password"
                               name="confirmPassword"
                               class="form-control"
                               placeholder="Confirm new password"
                               autocomplete="new-password"
                               required />

                    </div>

                </div>


                <!-- Button -->

                <button type="submit"
                        class="btn btn-reset">

                    <i class="bi bi-check-circle me-2"></i>

                    Reset Password

                </button>

            </form>

        </div>

    </div>

</body>

</html>