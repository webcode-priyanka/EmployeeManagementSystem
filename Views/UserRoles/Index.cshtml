@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "User & Roles";

    var userRoles =
        ViewBag.UserRoles
        as Dictionary<string, string>;
}

<style>

    body {
        background: #f5f7fb;
    }

    .roles-page {
        padding: 25px 5px 40px;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 14px;
    }

    .roles-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .table-header {
        padding: 22px 25px;
        border-bottom: 1px solid #eef0f4;
    }

    .table-title {
        font-size: 19px;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .table-subtitle {
        margin: 5px 0 0;
        color: #94a3b8;
        font-size: 13px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

        .users-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }

        .users-table td {
            padding: 17px 20px;
            border-bottom: 1px solid #eef0f4;
            color: #374151;
            font-size: 14px;
            vertical-align: middle;
        }

        .users-table tr:last-child td {
            border-bottom: none;
        }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #eef4ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .user-email {
        font-weight: 600;
        color: #1f2937;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #eef4ff;
        color: #2563eb;
    }

    .manage-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 8px;
        border: 1px solid #dbe5f2;
        background: #ffffff;
        color: #2563eb;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .manage-btn:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
            transform: translateY(-1px);
        }

    .alert-success {
        border: none;
        border-radius: 10px;
        background: #ecfdf5;
        color: #047857;
    }

    .alert-danger {
        border: none;
        border-radius: 10px;
        background: #fef2f2;
        color: #b91c1c;
    }

</style>


<div class="container-fluid roles-page">

    <!-- Header -->
    <div class="page-header">

        <h1 class="page-title">
            User & Roles
        </h1>

        <p class="page-subtitle">
            Manage user access and assign system roles
        </p>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }


    <!-- Users Card -->
    <div class="roles-card">

        <div class="table-header">

            <h2 class="table-title">
                System Users
            </h2>

            <p class="table-subtitle">
                View users and manage their access permissions
            </p>

        </div>


        <div class="table-responsive">

            <table class="users-table">

                <thead>

                    <tr>

                        <th>
                            User
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Current Role
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var user in Model)
                    {
                        var role = "No Role";

                        if (userRoles != null &&
                        userRoles.ContainsKey(user.Id))
                        {
                            role = userRoles[user.Id];
                        }

                        <tr>

                            <td>

                                <div class="user-info">

                                    <div class="user-icon">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <div class="user-email">
                                            @user.UserName
                                        </div>
                                    </div>

                                </div>

                            </td>


                            <td>
                                @user.Email
                            </td>


                            <td>

                                <span class="role-badge">
                                    <i class="bi bi-shield-check me-1"></i>
                                    @role
                                </span>

                            </td>


                            <td>

                                <a asp-action="Manage"
                                   asp-route-id="@user.Id"
                                   class="manage-btn">

                                    <i class="bi bi-person-gear"></i>

                                    Manage Role

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
