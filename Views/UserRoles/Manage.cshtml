@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Manage Role";

    var roles = ViewBag.Roles as string[];
    var currentRole = ViewBag.CurrentRole as string;
}

<style>

    body {
        background: #f5f7fb;
    }

    .manage-page {
        padding: 30px 5px 40px;
    }

    .manage-card {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .manage-header {
        padding: 28px;
        text-align: center;
        border-bottom: 1px solid #eef0f4;
    }

    .role-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eef4ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .manage-title {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 6px;
    }

    .manage-subtitle {
        color: #94a3b8;
        font-size: 14px;
        margin: 0;
    }

    .manage-body {
        padding: 28px;
    }

    .user-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 25px;
    }

    .user-label {
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .user-email {
        color: #1f2937;
        font-size: 16px;
        font-weight: 700;
    }

    .current-role {
        margin-top: 12px;
    }

    .role-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 12px;
        font-weight: 600;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-select {
        height: 48px;
        border-radius: 9px;
        border: 1px solid #dbe1ea;
    }

        .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    .manage-footer {
        padding: 20px 28px;
        background: #fafbfc;
        border-top: 1px solid #eef0f4;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-save {
        border: none;
        border-radius: 8px;
        padding: 11px 20px;
        background: #2563eb;
        color: white;
        font-weight: 600;
    }

        .btn-save:hover {
            background: #1d4ed8;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        padding: 10px 18px;
        border-radius: 8px;
        border: 1px solid #dbe1ea;
        background: white;
        color: #374151;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-cancel:hover {
            background: #f3f4f6;
            color: #111827;
        }

</style>


<div class="container-fluid manage-page">

    <div class="manage-card">

        <!-- Header -->
        <div class="manage-header">

            <div class="role-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h2 class="manage-title">
                Manage User Role
            </h2>

            <p class="manage-subtitle">
                Change access level for this user
            </p>

        </div>


        <!-- Body -->
        <form asp-action="Manage"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />


            <div class="manage-body">

                <div class="user-box">

                    <div class="user-label">
                        USER EMAIL
                    </div>

                    <div class="user-email">
                        @Model.Email
                    </div>

                    <div class="current-role">

                        <div class="user-label">
                            CURRENT ROLE
                        </div>

                        <span class="role-badge">
                            @currentRole
                        </span>

                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Select New Role
                    </label>

                    <select name="selectedRole"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Role --
                        </option>

                        @foreach (var role in roles)
                        {
                            if (role == currentRole)
                            {
                                <option value="@role"
                                        selected>
                                    @role
                                </option>
                            }
                            else
                            {
                                <option value="@role">
                                    @role
                                </option>
                            }
                        }

                    </select>

                </div>

            </div>


            <!-- Footer -->
            <div class="manage-footer">

                <a asp-action="Index"
                   class="btn-cancel">

                    ← Cancel

                </a>

                <button type="submit"
                        class="btn-save">

                    <i class="bi bi-check-lg me-1"></i>

                    Save Role

                </button>

            </div>

        </form>

    </div>

</div>
