@model IEnumerable<EmployeeManagementSystem.Models.Attendance>

@{
    ViewData["Title"] = "Attendance History";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Attendance History</h2>
            <p class="text-muted mb-0">
                View and search employee attendance records.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Attendance
        </a>

    </div>


    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="History" method="get">

                <div class="row g-3 align-items-end">

                    <!-- Employee Search -->
                    <div class="col-md-5">

                        <label class="form-label fw-semibold">
                            Search Employee
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Enter employee name..." />

                        </div>

                    </div>


                    <!-- Date -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Attendance Date
                        </label>

                        <input type="date"
                               name="date"
                               value="@ViewBag.Date"
                               class="form-control" />

                    </div>


                    <!-- Buttons -->
                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">

                            <i class="bi bi-funnel me-2"></i>
                            Filter

                        </button>


                        <a asp-action="History"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-clockwise"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- History Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Employee
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Check-In
                            </th>

                            <th>
                                Check-Out
                            </th>

                            <th>
                                Working Hours
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Employee -->
                                    <td class="ps-4 fw-semibold">

                                        @(item.Employee?.FirstName + " " +
                                            item.Employee?.LastName)

                                    </td>


                                    <!-- Date -->
                                    <td>

                                        @item.Date.ToString("dd MMM yyyy")

                                    </td>


                                    <!-- Check-In -->
                                    <td>

                                        @(
                                            item.CheckIn?.ToString("hh:mm tt")
                                            ?? "-"
                                            )

                                    </td>


                                    <!-- Check-Out -->
                                    <td>

                                        @(
                                            item.CheckOut?.ToString("hh:mm tt")
                                            ?? "-"
                                            )

                                    </td>


                                    <!-- Working Hours -->
                                    <td>

                                        <span class="fw-semibold">

                                            @item.WorkingHours

                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.CheckIn != null &&
                                       item.CheckOut == null)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock me-1"></i>

                                                Checked-In

                                            </span>
                                        }
                                        else if (item.CheckIn != null &&
                                        item.CheckOut != null)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Completed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @item.Status

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>

                                    No attendance history found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>


                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Attendance History Pagination">
                        <ul class="pagination justify-content-center mt-4">

                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="History"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-date="@ViewBag.Date"
                                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                                        Previous
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="History"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-date="@ViewBag.Date"
                                       asp-route-page="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="History"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-date="@ViewBag.Date"
                                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                                        Next
                                    </a>
                                </li>
                            }

                        </ul>
                    </nav>
                }

            </div>

        </div>

    </div>

</div>