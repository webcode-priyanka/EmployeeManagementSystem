@model EmployeeManagementSystem.Models.Attendance

@{
    ViewData["Title"] = "Employee Check-In";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Employee Check-In
                    </h4>
                </div>

                <div class="card-body p-4">

                    <form asp-action="CheckIn" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="EmployeeId"
                                   class="form-label fw-semibold">
                                Select Employee
                            </label>

                            <select asp-for="EmployeeId"
                                    asp-items="ViewBag.Employees"
                                    class="form-select">
                                <option value="">-- Select Employee --</option>
                            </select>

                            <span asp-validation-for="EmployeeId"
                                  class="text-danger"></span>
                        </div>

                        <div class="alert alert-light border">
                            <i class="bi bi-info-circle me-2"></i>
                            Today's date and check-in time will be recorded automatically.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>
                                Check In
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
