@model EmployeeManagementSystem.Models.Salary

@{
    ViewData["Title"] = "Delete Salary";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Delete Salary
        </h2>

        <p class="text-muted mb-0">
            Confirm before deleting this salary record
        </p>

    </div>


    <!-- Delete Confirmation Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <!-- Warning -->
            <div class="alert alert-warning d-flex align-items-center">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <div>
                    Are you sure you want to delete this salary record?
                    This action cannot be undone.
                </div>

            </div>


            <!-- Salary Information -->

            <div class="row mb-4">

                <!-- Employee -->
                <div class="col-md-6 mb-4">

                    <div class="text-muted small mb-1">
                        Employee
                    </div>

                    <div class="fw-semibold">

                        @Model.Employee?.FirstName
                        @Model.Employee?.LastName

                    </div>

                    @if (Model.Employee != null)
                    {
                        <small class="text-muted">
                            @Model.Employee.Email
                        </small>
                    }

                </div>


                <!-- Month -->
                <div class="col-md-6 mb-4">

                    <div class="text-muted small mb-1">
                        Salary Month
                    </div>

                    <div class="fw-semibold">

                        @Model.Month.ToString("MMMM yyyy")

                    </div>

                </div>


                <!-- Basic Salary -->
                <div class="col-md-4 mb-4">

                    <div class="text-muted small mb-1">
                        Basic Salary
                    </div>

                    <div class="fw-semibold">

                        ₹@Model.BasicSalary.ToString("N2")

                    </div>

                </div>


                <!-- Allowance -->
                <div class="col-md-4 mb-4">

                    <div class="text-muted small mb-1">
                        Allowance
                    </div>

                    <div class="fw-semibold">

                        ₹@Model.Allowance.ToString("N2")

                    </div>

                </div>


                <!-- Deduction -->
                <div class="col-md-4 mb-4">

                    <div class="text-muted small mb-1">
                        Deduction
                    </div>

                    <div class="fw-semibold">

                        ₹@Model.Deduction.ToString("N2")

                    </div>

                </div>


                <!-- Net Salary -->
                <div class="col-md-6 mb-2">

                    <div class="text-muted small mb-1">
                        Net Salary
                    </div>

                    <div class="fw-bold fs-5">

                        ₹@Model.NetSalary.ToString("N2")

                    </div>

                </div>

            </div>


            <!-- Buttons -->

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light border px-4">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash me-1"></i>
                        Delete Salary

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>