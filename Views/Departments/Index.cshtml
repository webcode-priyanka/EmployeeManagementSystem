@model IEnumerable<EmployeeManagementSystem.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>Department Management</h2>
        <p class="text-muted">Manage your company departments</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add Department
    </a>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        <h4 class="mb-3">Departments</h4>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Department Name</th>
                        <th>Description</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var department in Model)
                        {
                            <tr>
                                <td>@department.Id</td>

                                <td>
                                    <strong>@department.Name</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(department.Description)
                                        ? "-"
                                        : department.Description)
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@department.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@department.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No departments found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
