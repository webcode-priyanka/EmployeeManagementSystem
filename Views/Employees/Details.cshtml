@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";

    var documents =
        ViewBag.Documents
        as IEnumerable<EmployeeManagementSystem.Models.EmployeeDocument>;

    var requiredDocuments = new[]
    {
        "Aadhar Card",
        "PAN Card",
        "Resume",
        "Offer Letter",
        "Joining Letter",
        "Educational Certificate",
        "Experience Certificate",
        "Other"
    };

    var documentCount = documents?.Count() ?? 0;
}

<!-- =========================================================
     SUCCESS / ERROR ALERTS
     ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show page-alert" role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show page-alert" role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<style>

    /* =========================================================
           PAGE
           ========================================================= */

    body {
        background: #f5f7fb;
    }

    .details-page {
        padding: 20px 5px 40px;
    }


    /* =========================================================
           ALERT
           ========================================================= */

    .page-alert {
        margin: 15px 5px 0;
        border-radius: 10px;
        font-size: 14px;
        border: none;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 14px;
    }


    /* =========================================================
           MAIN DETAILS CARD
           ========================================================= */

    .details-card {
        background: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }


    /* =========================================================
           EMPLOYEE HEADER
           ========================================================= */

    .details-header {
        padding: 25px;
        border-bottom: 1px solid #eef0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .employee-profile {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .profile-icon {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
        box-shadow: inset 0 0 0 1px #bfdbfe;
    }

    .employee-name {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
    }

    .employee-id {
        font-size: 13px;
        color: #9ca3af;
        margin-top: 3px;
    }


    /* =========================================================
           EMPLOYEE STATUS
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-active {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-inactive {
        background: #f3f4f6;
        color: #6b7280;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }


    /* =========================================================
           DETAILS BODY
           ========================================================= */

    .details-body {
        padding: 28px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 18px;
    }


    /* =========================================================
           INFORMATION CARDS
           ========================================================= */

    .info-card {
        background: #f8fafc;
        border: 1px solid #eef0f4;
        border-radius: 11px;
        padding: 15px;
        height: 100%;
        transition: all 0.2s ease;
    }

        .info-card:hover {
            background: #ffffff;
            border-color: #dbeafe;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
            transform: translateY(-1px);
        }

    .info-label {
        display: block;
        font-size: 11px;
        color: #94a3b8;
        margin-bottom: 5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .info-value {
        display: block;
        font-size: 14px;
        color: #374151;
        font-weight: 600;
        word-break: break-word;
    }

    .salary-value {
        color: #15803d;
        font-weight: 700;
    }


    /* =========================================================
           DOCUMENTATION SECTION
           ========================================================= */

    .documents-section {
        margin-top: 38px;
        padding-top: 28px;
        border-top: 1px solid #eef0f4;
    }

    .documents-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .documents-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .documents-heading-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        box-shadow: inset 0 0 0 1px #dbeafe;
    }

    .documents-heading h5 {
        margin: 0;
        color: #1f2937;
        font-size: 17px;
        font-weight: 700;
    }

    .documents-heading p {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: 12px;
    }

    .document-count {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
        border-radius: 20px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
           DOCUMENT CARD
           ========================================================= */

    .document-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px;
        height: 100%;
        min-height: 255px;
        transition: all 0.25s ease;
        position: relative;
        display: flex;
        flex-direction: column;
    }

        .document-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
            transform: translateY(-2px);
        }


    /* =========================================================
           DOCUMENT TOP
           ========================================================= */

    .document-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .document-title-area {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .document-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #f1f5f9;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .document-name {
        font-size: 14px;
        font-weight: 700;
        color: #1f2937;
        line-height: 1.3;
    }

    .document-label {
        font-size: 10px;
        color: #94a3b8;
        margin-bottom: 2px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.3px;
    }


    /* =========================================================
           DOCUMENT STATUS
           ========================================================= */

    .document-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .document-status i {
            font-size: 10px;
        }

    .status-verified {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-rejected {
        background: #fef2f2;
        color: #dc2626;
    }

    .status-pending {
        background: #fffbeb;
        color: #b45309;
    }

    .status-not-uploaded {
        background: #f1f5f9;
        color: #64748b;
    }


    /* =========================================================
           FILE INFORMATION
           ========================================================= */

    .document-file-box {
        margin-top: 16px;
        padding: 11px 12px;
        background: #f8fafc;
        border-radius: 9px;
        border: 1px solid #eef0f4;
    }

    .document-file {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #475569;
        font-size: 12px;
        font-weight: 600;
        word-break: break-word;
    }

        .document-file i {
            color: #64748b;
            flex-shrink: 0;
        }

    .document-date {
        margin-top: 7px;
        color: #9ca3af;
        font-size: 11px;
    }


    /* =========================================================
           DOCUMENT ACTION ICONS
           ========================================================= */

    .document-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 14px;
    }

    .document-action-btn {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 14px;
    }

        .document-action-btn:hover {
            transform: translateY(-1px);
        }

    .view-document {
        color: #2563eb;
        background: #eff6ff;
        border-color: #bfdbfe;
    }

        .view-document:hover {
            background: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

    .delete-document {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }

        .delete-document:hover {
            background: #dc2626;
            color: #ffffff;
            border-color: #dc2626;
        }


    /* =========================================================
           VERIFICATION
           ========================================================= */

    .verification-box {
        margin-top: 15px;
        padding-top: 14px;
        border-top: 1px dashed #e5e7eb;
    }

    .verification-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .verification-box .form-select,
    .verification-box .form-control {
        border-radius: 7px;
        border-color: #dbe1ea;
        font-size: 12px;
        min-height: 35px;
        box-shadow: none;
    }

        .verification-box .form-select:focus,
        .verification-box .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .update-status-btn {
        margin-top: 8px;
        border: none;
        border-radius: 7px;
        background: #2563eb;
        color: #ffffff;
        padding: 7px 12px;
        font-size: 11px;
        font-weight: 600;
        transition: 0.2s;
    }

        .update-status-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
        }


    /* =========================================================
           UPLOAD AREA
           ========================================================= */

    .upload-area {
        margin-top: 17px;
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 11px;
        padding: 20px 14px;
        text-align: center;
        transition: all 0.2s ease;
    }

        .upload-area:hover {
            background: #f1f5f9;
            border-color: #93c5fd;
        }

    .upload-icon {
        width: 44px;
        height: 44px;
        margin: 0 auto 10px;
        border-radius: 50%;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .upload-title {
        color: #1f2937;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .upload-help {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        margin-bottom: 13px;
    }


    /* =========================================================
           FILE INPUT
           ========================================================= */

    .upload-input {
        display: none;
    }

    .custom-upload-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: #2563eb;
        color: #ffffff;
        padding: 8px 15px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
    }

        .custom-upload-label:hover {
            background: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .custom-upload-label i {
            font-size: 13px;
        }

    .selected-file-name {
        display: block;
        margin-top: 9px;
        color: #64748b;
        font-size: 10px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* =========================================================
           NOT UPLOADED
           ========================================================= */

    .not-uploaded-area {
        margin-top: 17px;
        border: 1px dashed #e2e8f0;
        background: #f8fafc;
        border-radius: 11px;
        padding: 20px 14px;
        text-align: center;
    }

    .not-uploaded-icon {
        width: 42px;
        height: 42px;
        margin: 0 auto 10px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .not-uploaded-title {
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 4px;
    }


    /* =========================================================
           FOOTER
           ========================================================= */

    .details-footer {
        padding: 20px 28px;
        border-top: 1px solid #eef0f4;
        background: #fafbfc;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-edit {
        background: #f59e0b;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-edit:hover {
            background: #d97706;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .btn-back {
        background: #ffffff;
        color: #374151;
        border: 1px solid #dbe1ea;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-back:hover {
            background: #f3f4f6;
            color: #111827;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 992px) {

        .document-card {
            min-height: auto;
        }
    }

    @@media (max-width: 768px) {

        .details-page {
            padding: 15px 3px 30px;
        }

        .page-title {
            font-size: 23px;
        }

        .details-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .details-body {
            padding: 20px;
        }

        .documents-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .document-count {
            align-self: flex-start;
        }

        .details-footer {
            flex-direction: column-reverse;
        }

        .btn-edit,
        .btn-back {
            width: 100%;
            text-align: center;
        }
    }

</style>


<div class="container-fluid details-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="mb-4">

        <h2 class="page-title">
            Employee Details
        </h2>

        <p class="page-subtitle mb-0">
            View complete information about this employee
        </p>

    </div>


    <!-- =====================================================
         MAIN CARD
         ===================================================== -->

    <div class="details-card">


        <!-- =================================================
             EMPLOYEE HEADER
             ================================================= -->

        <div class="details-header">

            <div class="employee-profile">

                <div class="profile-icon">

                    @if (!string.IsNullOrEmpty(Model.FirstName))
                    {
                        @Model.FirstName.Substring(0, 1).ToUpper()
                    }
                    else
                    {
                        <span>?</span>
                    }

                </div>

                <div>

                    <div class="employee-name">
                        @Model.FirstName @Model.LastName
                    </div>

                    <div class="employee-id">
                        Employee ID: #@Model.Id
                    </div>

                </div>

            </div>


            <!-- STATUS -->

            <div>

                @if (Model.Status == "Active")
                {
                    <span class="status-badge status-active">

                        <span class="status-dot"></span>

                        Active

                    </span>
                }
                else
                {
                    <span class="status-badge status-inactive">

                        <span class="status-dot"></span>

                        Inactive

                    </span>
                }

            </div>

        </div>


        <!-- =================================================
             DETAILS BODY
             ================================================= -->

        <div class="details-body">


            <!-- =================================================
                 PERSONAL INFORMATION
                 ================================================= -->

            <div class="section-title">
                Personal Information
            </div>

            <div class="row g-3 mb-4">


                <!-- FIRST NAME -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            First Name
                        </span>

                        <span class="info-value">
                            @Model.FirstName
                        </span>

                    </div>

                </div>


                <!-- LAST NAME -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Last Name
                        </span>

                        <span class="info-value">
                            @Model.LastName
                        </span>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Email Address
                        </span>

                        <span class="info-value">
                            @Model.Email
                        </span>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Phone Number
                        </span>

                        <span class="info-value">
                            @Model.Phone
                        </span>

                    </div>

                </div>


                <!-- DOB -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Date of Birth
                        </span>

                        <span class="info-value">
                            @Model.DateOfBirth.ToString("dd-MM-yyyy")
                        </span>

                    </div>

                </div>


                <!-- JOINING DATE -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Joining Date
                        </span>

                        <span class="info-value">
                            @Model.JoiningDate.ToString("dd-MM-yyyy")
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 JOB INFORMATION
                 ================================================= -->

            <div class="section-title">
                Job Information
            </div>

            <div class="row g-3 mb-4">


                <!-- DESIGNATION -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Designation
                        </span>

                        <span class="info-value">
                            @Model.Designation
                        </span>

                    </div>

                </div>


                <!-- DEPARTMENT -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Department
                        </span>

                        <span class="info-value">

                            @if (Model.Department != null)
                            {
                                @Model.Department.Name
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Assigned
                                </span>
                            }

                        </span>

                    </div>

                </div>


                <!-- SALARY -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Salary
                        </span>

                        <span class="info-value salary-value">
                            ₹@Model.Salary.ToString("N2")
                        </span>

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-md-6 col-lg-4">

                    <div class="info-card">

                        <span class="info-label">
                            Employee Status
                        </span>

                        <span class="info-value">
                            @Model.Status
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 EMPLOYEE DOCUMENTS
                 ================================================= -->

            <div class="documents-section">


                <!-- DOCUMENT HEADER -->

                <div class="documents-header">

                    <div class="documents-heading">

                        <div class="documents-heading-icon">

                            <i class="bi bi-folder2-open"></i>

                        </div>

                        <div>

                            <h5>
                                Employee Documents
                            </h5>

                            <p>
                                Manage, upload and verify employee documents
                            </p>

                        </div>

                    </div>


                    <div class="document-count">

                        <i class="bi bi-file-earmark-text"></i>

                        @documentCount / @requiredDocuments.Length Documents

                    </div>

                </div>


                <!-- =================================================
                     DOCUMENT GRID
                     ================================================= -->

                <div class="row g-3">


                    @foreach (var documentType in requiredDocuments)
                    {
                        var document =
                        documents?.FirstOrDefault(d =>
                        d.DocumentType == documentType);


                        <div class="col-md-6 col-xl-4">

                            <div class="document-card">


                                <!-- =================================================
                                     DOCUMENT TOP
                                     ================================================= -->

                                <div class="document-top">

                                    <div class="document-title-area">

                                        <div class="document-icon">

                                            <i class="bi bi-file-earmark-text"></i>

                                        </div>

                                        <div>

                                            <div class="document-label">
                                                Document
                                            </div>

                                            <div class="document-name">
                                                @documentType
                                            </div>

                                        </div>

                                    </div>


                                    <!-- STATUS -->
                                    @if (document != null)
                                    {
                                        @if (document.VerificationStatus == "Verified")
                                        {
                                            <span class="document-status status-verified">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Verified

                                            </span>
                                        }
                                        else if (document.VerificationStatus == "Rejected")
                                        {
                                            <span class="document-status status-rejected">

                                                <i class="bi bi-x-circle-fill"></i>

                                                Rejected

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="document-status status-pending">

                                                <i class="bi bi-clock-fill"></i>

                                                Pending

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="document-status status-not-uploaded">

                                            <i class="bi bi-dash-circle"></i>

                                            Not Uploaded

                                        </span>
                                    }

                                </div>


                                <!-- =================================================
                                     DOCUMENT EXISTS
                                     ================================================= -->
                                @if (document != null)
                                {

                                    <!-- FILE INFORMATION -->

                                    <div class="document-file-box">

                                        <div class="document-file">

                                            <i class="bi bi-file-earmark"></i>

                                            <span>
                                                @document.FileName
                                            </span>

                                        </div>

                                        <div class="document-date">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            Uploaded
                                            @document.UploadedAt.ToString("dd-MM-yyyy hh:mm tt")

                                        </div>

                                    </div>


                                    <!-- ACTION BUTTONS -->

                                    <div class="document-actions">


                                        <!-- VIEW -->

                                        <a href="@document.FilePath"
                                           target="_blank"
                                           class="document-action-btn view-document"
                                           title="View Document">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- DELETE -->
                                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                        {
                                            <form asp-controller="Documents"
                                                  asp-action="Delete"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this document?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@document.Id" />

                                                <input type="hidden"
                                                       name="employeeId"
                                                       value="@Model.Id" />

                                                <button type="submit"
                                                        class="document-action-btn delete-document"
                                                        title="Delete Document">

                                                    <i class="bi bi-trash3"></i>

                                                </button>

                                            </form>
                                        }

                                    </div>


                                    <!-- =================================================
                                         VERIFICATION
                                         ================================================= -->
                                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                    {

                                        <div class="verification-box">

                                            <span class="verification-label">

                                                <i class="bi bi-shield-check me-1"></i>

                                                Document Verification

                                            </span>


                                            <form asp-controller="Documents"
                                                  asp-action="Verify"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@document.Id" />

                                                <input type="hidden"
                                                       name="employeeId"
                                                       value="@Model.Id" />


                                                <div class="row g-2">


                                                    <!-- STATUS -->

                                                    <div class="col-5">

                                                        <select name="status"
                                                                class="form-select form-select-sm">

                                                            <option value="Pending"
                                                                    selected="@(document.VerificationStatus == "Pending")">
                                                                Pending
                                                            </option>

                                                            <option value="Verified"
                                                                    selected="@(document.VerificationStatus == "Verified")">
                                                                Verified
                                                            </option>

                                                            <option value="Rejected"
                                                                    selected="@(document.VerificationStatus == "Rejected")">
                                                                Rejected
                                                            </option>

                                                        </select>

                                                    </div>


                                                    <!-- REMARKS -->

                                                    <div class="col-7">

                                                        <input type="text"
                                                               name="remarks"
                                                               value="@document.Remarks"
                                                               class="form-control form-control-sm"
                                                               placeholder="Remarks..." />

                                                    </div>

                                                </div>


                                                <!-- UPDATE STATUS -->

                                                <button type="submit"
                                                        class="update-status-btn">

                                                    <i class="bi bi-check2-circle me-1"></i>

                                                    Update Status

                                                </button>

                                            </form>

                                        </div>

                                    }

                                }


                                <!-- =================================================
                                     DOCUMENT NOT UPLOADED
                                     ================================================= -->
                                @if (document == null)
                                {

                                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                    {

                                        <!-- ADMIN / HR UPLOAD -->

                                        <div class="upload-area">

                                            <div class="upload-icon">

                                                <i class="bi bi-cloud-arrow-up"></i>

                                            </div>

                                            <div class="upload-title">
                                                Upload Document
                                            </div>

                                            <small class="upload-help">
                                                PDF, JPG, PNG, DOC, DOCX — Max 5 MB
                                            </small>


                                            <!-- =================================================
                                                 UPLOAD FORM
                                                 ================================================= -->

                                            <form asp-controller="Documents"
                                                  asp-action="Upload"
                                                  method="post"
                                                  enctype="multipart/form-data">

                                                @Html.AntiForgeryToken()


                                                <input type="hidden"
                                                       name="employeeId"
                                                       value="@Model.Id" />


                                                <input type="hidden"
                                                       name="documentType"
                                                       value="@documentType" />


                                                <!-- =================================================
                                                     HIDDEN FILE INPUT

                                                     FILE SELECT KARTE HI FORM SUBMIT HOGA
                                                     ================================================= -->

                                                <input type="file"
                                                       id="file_@documentType.Replace(" ", "_")"
                                                       name="file"
                                                       class="upload-input"
                                                       accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
                                                       required
                                                       onchange="this.form.submit();" />


                                                <!-- =================================================
                                                     CHOOSE FILE BUTTON
                                                     ================================================= -->

                                                <label for="file_@documentType.Replace(" ", "_")"
                                                       class="custom-upload-label">

                                                    <i class="bi bi-upload"></i>

                                                    Choose File

                                                </label>


                                                <span class="selected-file-name">
                                                    Select a file to upload
                                                </span>

                                            </form>

                                        </div>

                                    }
                                    else
                                    {

                                        <!-- EMPLOYEE VIEW -->

                                        <div class="not-uploaded-area">

                                            <div class="not-uploaded-icon">

                                                <i class="bi bi-file-earmark-x"></i>

                                            </div>

                                            <div class="not-uploaded-title">
                                                Document Not Uploaded
                                            </div>

                                            <small class="upload-help mb-0">
                                                Contact Admin or HR to upload this document.
                                            </small>

                                        </div>

                                    }

                                }

                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <div class="details-footer">


            <!-- BACK -->

            <a asp-action="Index"
               class="btn-back">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Employees

            </a>


            <!-- EDIT -->
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn-edit">

                    <i class="bi bi-pencil me-1"></i>

                    Edit Employee

                </a>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     AUTO HIDE ALERT
     ========================================================= -->

<script>

    setTimeout(function () {

        document.querySelectorAll(".page-alert").forEach(function (alertElement) {

            if (typeof bootstrap !== "undefined") {

                bootstrap.Alert
                    .getOrCreateInstance(alertElement)
                    .close();

            }

        });

    }, 4000);

</script>