
@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<style>
    .create-page {
        background: #f5f7fb;
        min-height: 80vh;
    }

    .create-header {
        margin: 0 auto 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .create-header h1 {
            margin: 0;
            color: #172033;
            font-size: 30px;
            font-weight: 700;
        }

        .create-header p {
            margin: 6px 0 0;
            color: #7b8496;
            font-size: 14px;
        }

    .back-btn {
        background: white;
        color: #374151;
        padding: 11px 18px;
        border: 1px solid #e1e5eb;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .create-card {
        margin: auto;
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 25px 30px;
        border-bottom: 1px solid #edf0f4;
    }

    .form-icon {
        width: 48px;
        height: 48px;
        background: #eff6ff;
        color: #2563eb;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 25px;
        font-weight: 600;
    }

    .form-card-header h2 {
        margin: 0;
        color: #172033;
        font-size: 19px;
    }

    .form-card-header p {
        margin: 5px 0 0;
        color: #8a94a6;
        font-size: 13px;
    }

    .create-card form {
        padding: 30px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 22px;
        color: #172033;
        font-size: 15px;
        font-weight: 700;
    }

        .section-title span {
            width: 4px;
            height: 18px;
            background: #2563eb;
            border-radius: 5px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px 25px;
    }

    .form-field label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
    }

    .form-field input,
    .form-field select {
        width: 100%;
        box-sizing: border-box;
        min-height: 44px;
        padding: 10px 13px;
        border: 1px solid #dfe3ea;
        border-radius: 8px;
        background: white;
        outline: none;
        font-size: 14px;
    }

        .form-field input:focus,
        .form-field select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.08);
        }

    .salary-input {
        display: flex;
        align-items: center;
        border: 1px solid #dfe3ea;
        border-radius: 8px;
        overflow: hidden;
        min-height: 44px;
    }

        .salary-input span {
            padding-left: 13px;
            color: #6b7280;
            font-weight: 600;
        }

        .salary-input input {
            border: none;
            outline: none;
            box-shadow: none;
        }

    .field-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f4;
    }

    .cancel-btn,
    .save-btn {
        padding: 11px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .cancel-btn {
        background: #f3f4f6;
        color: #374151;
    }

    .save-btn {
        border: none;
        background: #2563eb;
        color: white;
        cursor: pointer;
    }

        .save-btn:hover {
            background: #1d4ed8;
        }

    @@media (max-width: 700px) {
        .create-page

    {
        padding: 20px;
    }

    .create-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .create-card form {
        padding: 20px;
    }

    .form-footer {
        flex-direction: column;
    }

    }

    .page-header {
        width: 100%;
    }

    .page-title {
        font-size: 48px;
        font-weight: 700;
        color: #17233d;
        margin: 0;
    }

    .page-subtitle {
        font-size: 17px;
        color: #6f7f98;
    }

    .back-employees-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        padding: 0 20px;
        background: #ffffff;
        color: #243653;
        border: 1px solid #dfe5ef;
        border-radius: 11px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 3px 10px rgba(30, 50, 80, 0.05);
        transition: all 0.25s ease;
    }

    .back-employees-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 190px;
        height: 48px;
        padding: 0 20px;
        border-radius: 12px;
        border: 1px solid #d7e2f2;
        background: #ffffff;
        color: #24507f;
        text-decoration: none;
        font-size: 14px;
        font-weight: 650;
        letter-spacing: 0.1px;
        box-shadow: 0 4px 12px rgba(30, 55, 90, 0.06);
        transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }

    .professional-back-btn {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 10px !important;
        height: 46px !important;
        padding: 0 18px !important;
        background: #ffffff !important;
        color: #344563 !important;
        border: 1px solid #d9e2ef !important;
        border-radius: 10px !important;
        text-decoration: none !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 12px rgba(31, 52, 80, 0.07) !important;
        transition: all 0.25s ease !important;
    }

        .professional-back-btn i {
            width: 28px !important;
            height: 28px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            border-radius: 8px !important;
            background: #eef4ff !important;
            color: #2563eb !important;
            font-size: 14px !important;
            transition: all 0.25s ease !important;
        }

        .professional-back-btn:hover {
            background: #f8fbff !important;
            color: #1d4ed8 !important;
            border-color: #bfd2f1 !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.12) !important;
        }

            .professional-back-btn:hover i {
                background: #2563eb !important;
                color: #ffffff !important;
                transform: translateX(-3px) !important;
            }

        .professional-back-btn:active {
            transform: translateY(0) !important;
        }
</style>

<div class="page-header d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="page-title mb-2">
            Add Employee
        </h1>

        <p class="page-subtitle mb-0">
            Add a new employee to your organization
        </p>
    </div>

    <a asp-action="Index" class="professional-back-btn">
        <i class="bi bi-arrow-left"></i>
        <span>Back to Employees</span>
    </a>

</div>


    <!-- Form Card -->
    <div class="create-card">

        <div class="form-card-header">

            <div class="form-icon">
                +
            </div>

            <div>
                <h2>Employee Information</h2>
                <p>Please enter the employee details below</p>
            </div>

        </div>


        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- Personal Information -->

            <div class="section-title">
                <span></span>
                Personal Information
            </div>


            <div class="form-grid">

                <!-- First Name -->

                <div class="form-field">

                    <label asp-for="FirstName">
                        First Name
                    </label>

                    <input asp-for="FirstName"
                           placeholder="Enter first name" />

                    <span asp-validation-for="FirstName"
                          class="field-error">
                    </span>

                </div>


                <!-- Last Name -->

                <div class="form-field">

                    <label asp-for="LastName">
                        Last Name
                    </label>

                    <input asp-for="LastName"
                           placeholder="Enter last name" />

                    <span asp-validation-for="LastName"
                          class="field-error">
                    </span>

                </div>


                <!-- Email -->

                <div class="form-field">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="example@email.com" />

                    <span asp-validation-for="Email"
                          class="field-error">
                    </span>

                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Enter 10 digit phone number"
                           maxlength="10"
                           minlength="10"
                           inputmode="numeric"
                           pattern="[0-9]{10}"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />

                    <span asp-validation-for="Phone"
                          class="text-danger">
                    </span>

                    
                </div>


                <!-- Date of Birth -->

                <div class="form-field">

                    <label asp-for="DateOfBirth">
                        Date of Birth
                    </label>

                    <input asp-for="DateOfBirth"
                           type="date" />

                    <span asp-validation-for="DateOfBirth"
                          class="field-error">
                    </span>

                </div>


                <!-- Joining Date -->

                <div class="form-field">

                    <label asp-for="JoiningDate">
                        Joining Date
                    </label>

                    <input asp-for="JoiningDate"
                           type="date" />

                    <span asp-validation-for="JoiningDate"
                          class="field-error">
                    </span>

                </div>


                <!-- Designation -->

                <div class="form-field">

                    <label asp-for="Designation">
                        Designation
                    </label>

                    <input asp-for="Designation"
                           placeholder="e.g. Software Developer" />

                    <span asp-validation-for="Designation"
                          class="field-error">
                    </span>

                </div>


                <!-- Department -->

                <div class="form-field">

                    <label asp-for="DepartmentId">
                        Department
                    </label>

                    <select asp-for="DepartmentId">

                        <option value="">
                            Select Department
                        </option>

                        @foreach (var department in ViewBag.Departments)
                        {
                            <option value="@department.Id">
                                @department.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="DepartmentId"
                          class="field-error">
                    </span>

                </div>


                <!-- Salary -->

                <div class="form-field">

                    <label asp-for="Salary">
                        Salary
                    </label>

                    <div class="salary-input">

                        <span>₹</span>

                        <input asp-for="Salary"
                               type="number"
                               step="0.01"
                               placeholder="Enter salary" />

                    </div>

                    <span asp-validation-for="Salary"
                          class="field-error">
                    </span>

                </div>


                <!-- Status -->

                <div class="form-field">

                    <label asp-for="Status">
                        Status
                    </label>

                    <select asp-for="Status">

                        <option value="Active">
                            Active
                        </option>

                        <option value="Inactive">
                            Inactive
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- Buttons -->

            <div class="form-footer">

                <a asp-action="Index"
                   class="cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="save-btn">
                    ✓ Save Employee
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
