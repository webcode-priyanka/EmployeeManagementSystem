@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<style>
    body {
        background: #f5f7fb;
    }

    .delete-page {
        padding: 30px 5px 40px;
    }

    .delete-card {
        max-width: 650px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
        overflow: hidden;
    }

    .delete-header {
        padding: 25px;
        text-align: center;
        border-bottom: 1px solid #eef0f4;
    }

    .warning-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
    }

    .delete-title {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 7px;
    }

    .delete-subtitle {
        color: #6b7280;
        font-size: 14px;
        margin: 0;
    }

    .delete-body {
        padding: 25px;
    }

    .employee-box {
        background: #f8fafc;
        border: 1px solid #eef0f4;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .employee-name {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
    }

    .employee-id {
        font-size: 13px;
        color: #9ca3af;
        margin-top: 3px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px solid #eef0f4;
        font-size: 14px;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #6b7280;
        font-weight: 600;
    }

    .info-value {
        color: #374151;
        font-weight: 600;
        text-align: right;
    }

    .warning-message {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 8px;
        padding: 13px 15px;
        font-size: 13px;
        margin-top: 20px;
    }

    .delete-footer {
        padding: 20px 25px;
        border-top: 1px solid #eef0f4;
        background: #fafbfc;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-delete {
        background: #dc2626;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #b91c1c;
            transform: translateY(-1px);
        }

    .btn-cancel {
        background: #ffffff;
        color: #374151;
        border: 1px solid #dbe1ea;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #f3f4f6;
            color: #111827;
        }

    @@media (max-width: 576px) {
        .delete-footer {
            flex-direction: column-reverse;
        }

        .btn-delete,
        .btn-cancel {
            width: 100%;
            text-align: center;
        }

        .info-row {
            flex-direction: column;
            gap: 3px;
        }

        .info-value {
            text-align: left;
        }
    }
</style>


<div class="container-fluid delete-page">

    <div class="delete-card">

        <!-- Header -->
        <div class="delete-header">

            <div class="warning-icon">
                !
            </div>

            <h2 class="delete-title">
                Delete Employee
            </h2>

            <p class="delete-subtitle">
                Are you sure you want to delete this employee?
            </p>

        </div>


        <!-- Employee Information -->
        <div class="delete-body">

            <div class="employee-box">

                <div class="employee-name">
                    @Model.FirstName @Model.LastName
                </div>

                <div class="employee-id">
                    Employee ID: #@Model.Id
                </div>

                <div class="mt-3">

                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value">@Model.Email</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Phone</span>
                        <span class="info-value">@Model.Phone</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Designation</span>
                        <span class="info-value">@Model.Designation</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Status</span>
                        <span class="info-value">@Model.Status</span>
                    </div>

                </div>

            </div>


            <div class="warning-message">
                <strong>Warning:</strong>
                This action cannot be undone. The employee record will be permanently deleted.
            </div>

        </div>


        <!-- Buttons -->
        <div class="delete-footer">

            <a asp-action="Index"
               class="btn-cancel">
                ← Cancel
            </a>


            <form asp-action="Delete"
                  method="post"
                  class="d-inline">

                <input type="hidden"
                       asp-for="Id" />

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-delete"
                        onclick="return confirm('Are you sure you want to permanently delete this employee?');">
                    🗑 Delete Employee
                </button>

            </form>

        </div>

    </div>

</div>